{
  "multipart": [
    {
      "apply": {
        "model": "promptcritical:block/gas_collector_main"
      }
    },
    {
      "apply": {
        "model": "promptcritical:block/gas_collector_main_side",
        "y": 90
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "promptcritical:block/gas_collector_main_side",
        "y": 180
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "promptcritical:block/gas_collector_main_side",
        "y": 270
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "promptcritical:block/gas_collector_main_side"
      },
      "when": {
        "west": "true"
      }
    }
  ]
}